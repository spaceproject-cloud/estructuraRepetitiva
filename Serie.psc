Algoritmo Serie
	Definir contadorN, cantidadT, termino Como Entero
	Imprimir " Ingrese la cantidad de terminos "
	Leer cantidadT
	contadorN = 0
	termino = 1
	Repetir
		Imprimir termino, " , "
		termino = termino + 2
		contadorN = contadorN +1
	Mientras Que  contadorN < cantidadT-1
	
	Imprimir termino
FinAlgoritmo
